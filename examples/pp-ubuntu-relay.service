[Unit]
Description=Private alpha port relay
After=network-online.target
Wants=network-online.target

[Service]
User=pp-ubuntu-relay
Group=pp-ubuntu-relay
StateDirectory=pp-ubuntu-relay
WorkingDirectory=/opt/pp-ubuntu
ExecStart=/opt/pp-ubuntu/.venv/bin/container-manager --config /etc/pp-ubuntu/relay.json
Restart=on-failure
UMask=0077
LimitNOFILE=4096
# Required only for exact read-only sudo commands in relay.sudoers.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/pp-ubuntu

[Install]
WantedBy=multi-user.target
